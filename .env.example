# QuantNucleo — Exemplo .env (NUNCA commitar o .env real)
# =========================================================

# --- Geral ---
AMBIENTE=dev
DEBUG=true
LOG_LEVEL=INFO

# --- Azure ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-quantnucleo
AZURE_STORAGE_ACCOUNT=stquantnucleo
AZURE_KEYVAULT_URL=https://kv-quantnucleo.vault.azure.net/
AZURE_SYNAPSE_WORKSPACE=

# --- MongoDB Atlas ---
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/quantnucleo
MONGO_DATABASE=quantnucleo

# --- TradingView ---
TV_WEBHOOK_SECRET=seu-webhook-secret-aqui
TV_WEBHOOK_ENDPOINT=/api/v1/webhooks/tradingview

# --- Datadog ---
DD_API_KEY=
DD_APP_KEY=
DD_SERVICE=quantnucleo
DD_ENV=dev
DD_ENABLE_TRACING=true

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Market Data ---
MARKET_DEFAULT_INTERVAL=1d
MARKET_MAX_RETRIES=3

# --- Risk ---
RISK_VAR_CONFIDENCE=0.95
RISK_MC_SIMULATIONS=10000
RISK_MAX_DRAWDOWN_THRESHOLD=-0.15
RISK_MAX_SINGLE_POSITION=0.30

# --- LSTM ---
LSTM_HIDDEN_UNITS=50
LSTM_LOOK_BACK=60
LSTM_EPOCHS=30
LSTM_BATCH_SIZE=32
LSTM_SEED=42
