# =====================================================================
# QuantNucleo — Dockerfile API
# =====================================================================
# Multi-stage build para imagem produção leve

FROM python:3.11-slim as builder

WORKDIR /app

# Instalar dependências de build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir --prefix=/install .

# --- Produção ---
FROM python:3.11-slim

WORKDIR /app

# Labels
LABEL maintainer="Núcleo Quant LMF/UFU"
LABEL description="QuantNucleo API"

# Copiar dependências instaladas
COPY --from=builder /install /usr/local

# Copiar código
COPY config/ config/
COPY libs/ libs/
COPY services/api/ services/api/
COPY strategies/ strategies/

# Variáveis
ENV PYTHONUNBUFFERED=1
ENV AMBIENTE=prod

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import httpx; r=httpx.get('http://localhost:8000/health'); assert r.status_code==200"

EXPOSE 8000

CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
